    { "time": 25.961539, "end": 43.269231, "measure": 11, "beat": 1, "text": "DRAMA KÖPRÜSÜNÜ BRE HASAN\r\nGECE Mİ GEÇTİN HASAN\r\nGECE Mİ GEÇTİN" },
