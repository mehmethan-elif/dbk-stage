    { "time": 129.807693, "end": 147.115385, "measure": 47, "beat": 1, "text": "DRAMA KÖPRÜSÜ BRE HASAN\r\nDARDIR GEÇİLMEZ HASAN\r\nDARDIR GEÇİLMEZ" },
