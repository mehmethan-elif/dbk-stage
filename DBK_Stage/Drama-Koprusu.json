    { "time": 25.961538, "end": 43.269231, "measure": 9, "beat": 10, "text": "DRAMA KÖPRÜSÜNÜ BRE HASAN \r\nGECE Mİ GEÇTİN HASAN \r\nGECE Mİ GEÇTİN" },
    { "time": 43.269231, "end": 54.807692, "measure": 16, "beat": 1, "text": "ECEL ŞERBETİNİ BRE HASAN\r\n ÖLMEDEN İÇTİN" },
    { "time": 54.807692, "end": 66.346154, "measure": 19, "beat": 10, "text": "ECEL ŞERBETİNİ BRE HASAN\r\n ÖLMEDEN İÇTİN" },
    { "time": 66.346154, "end": 83.653846, "measure": 24, "beat": 1, "text": "ANADAN BABADAN BRE HASAN \r\nNASIL VAZGEÇTİN HASAN \r\nNASIL VAZGEÇTİN" },
    { "time": 83.653846, "end": 95.192308, "measure": 29, "beat": 10, "text": "AT MARTİNİ DEBRELİ HASAN \r\nDAĞLAR İNLESİN" },
    { "time": 95.192308, "end": 106.730769, "measure": 34, "beat": 1, "text": "DRAMA MAHPUSUNDA BRE HASAN \r\nNAMIN YÜRÜSÜN" },
    { "time": 129.807692, "end": 147.115385, "measure": 45, "beat": 10, "text": "DRAMA KÖPRÜSÜ BRE HASAN \r\nDARDIR GEÇİLMEZ HASAN \r\nDARDIR GEÇİLMEZ" },
    { "time": 147.115385, "end": 158.653846, "measure": 52, "beat": 1, "text": "SOĞUKTUR SULARI BRE HASAN \r\nBİR TAS İÇİLMEZ" },
    { "time": 158.653846, "end": 170.192308, "measure": 55, "beat": 10, "text": "SOĞUKTUR SULARI BRE HASAN \r\nBİR TAS İÇİLMEZ" },
