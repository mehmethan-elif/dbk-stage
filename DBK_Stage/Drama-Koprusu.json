    { "time": 54.807693, "end": 66.346154, "measure": 21, "beat": 1, "text": "ECEL ŞERBETİNİ BRE HASAN\r\n ÖLMEDEN İÇTİN" },
    { "time": 66.346154, "end": 83.653847, "measure": 24, "beat": 1, "text": "ANADAN BABADAN BRE HASAN\r\nNASIL VAZGEÇTİN HASAN\r\nNASIL VAZGEÇTİN" },
